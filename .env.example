# MedBridge Go credentials (one account for all programs)
MEDBRIDGE_USERNAME=your_email@example.com
MEDBRIDGE_PASSWORD=your_password

# Access tokens and display names (one program per token)
# Add as many pairs as you need: TOKEN_1/NAME_1, TOKEN_2/NAME_2, ...
TOKEN_1=your_first_access_token_here
NAME_1=knee

TOKEN_2=your_second_access_token_here
NAME_2=elbow
